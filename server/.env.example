# Copy to /etc/aquarius-api.env on the server (never commit real values).
DATABASE_URL=postgres://aquarius:PASSWORD@127.0.0.1:5432/aquarius
PORT=4000
HOST=127.0.0.1
# "true" in production behind HTTPS
COOKIE_SECURE=true
# Ключ Cars Base (тариф «Полный с фото»)
CARSBASE_TOKEN=
CARSBASE_LOGO_DIR=/var/lib/aquarius/logos
